    {
        type            fixedGradient;   //    -q/k_w = (0.32e+06 / 27.244 ) // check if it is +ve 
        gradient        uniform 1.174571e+04 ; 
    }
    dwt_f_interface
    {
         type            zeroGradient ;     
    }
    dwt_inner
    {
        type            fixedGradient;   //    -q/k_w = (-0.323e+06 / 27.244 ) // check if it is +ve  
        gradient        uniform -1.1855821e+04 ;
    }
    dwt_exterior
    {
//        type            fixedGradient;   //    -q/k_w = (-0.323e+06 / 27.244 ) // check if it is +ve  
//        gradient        uniform -1.1855821e+04 ;
          type            zeroGradient;
    }


    exterior
    {
        type            zeroGradient;
    }
    solid_to_fluid
    {

       type                solidWallMixedTemperatureCoupled; // solidWallMixedTemperatureCoupled
       Tnbr                       T;                                //
       K                          K;
       value                uniform 573.0 ;
    }
   

}



