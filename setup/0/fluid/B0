FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0/fluid";
    object      B0;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 1 0 -2 0 0 -1 0 ];

B0              (0 0 1.0) ; // [T]  vector! direction assumed +z, must be normal to the x-directed inlet flow

internalField   uniform $B0;

boundaryField
{
    dwt_f_interface
    {
        type            zeroGradient;
    }

    inlet
    {
        type            zeroGradient;
    }

    outlet
    {
        type            zeroGradient;
    }

    fluid_to_solid
    {
        type            zeroGradient;
    }
}

